{
    "name": "craftile/laravel",
    "description": "Craftile Laravel Package",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Eldo Magan",
            "email": "magan.eldo@gmail.com",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Craftile\\Laravel\\": "src/"
        },
         "files": [
            "src/helpers.php"
        ]
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "craftile/core": "self.version",
        "stillat/blade-parser": "^2.0",
        "symfony/yaml": "^7.0|^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/phpstan": "^2.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Craftile\\Laravel\\CraftileServiceProvider"
            ],
            "aliases": {
                "Craftile": "Craftile\\Laravel\\Facades\\Craftile",
                "BlockDatastore": "Craftile\\Laravel\\Facades\\BlockDatastore"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
